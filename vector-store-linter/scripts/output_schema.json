{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bhaelen/bhaelen_sample_skills/vector-store-linter/output_schema.json",
  "title": "vector-store-linter scorecard",
  "description": "Stable JSON output of the vector-store-linter. Consumed by CI. Additive changes only within a schema_version; removals or renames bump schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "scored_at",
    "overall_score",
    "grade",
    "tier_scores",
    "summary",
    "critical_findings",
    "top_fixes",
    "results",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Output schema version. Currently 1.0."
    },
    "scored_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the scoring run."
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "F"]
    },
    "tier_scores": {
      "type": "object",
      "description": "Per-tier score, 0 to 100, only for tiers that were evaluated.",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
    },
    "summary": {
      "type": "object",
      "required": ["criteria_evaluated", "passed", "failing_by_severity"],
      "properties": {
        "criteria_evaluated": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failing_by_severity": {
          "type": "object",
          "description": "Count of failing results grouped by effective severity.",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "critical_findings": {
      "type": "array",
      "description": "Criterion ids of failing results whose effective severity is critical.",
      "items": {"type": "string"}
    },
    "top_fixes": {
      "type": "array",
      "description": "Failing results ranked by severity then weighted score impact.",
      "items": {
        "type": "object",
        "required": ["criterion_id", "severity", "score", "weight", "message"],
        "properties": {
          "criterion_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warn", "fail", "critical"]},
          "score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "weight": {"type": ["integer", "null"]},
          "message": {"type": "string"}
        }
      }
    },
    "results": {
      "type": "array",
      "description": "Every check result, in rubric order.",
      "items": {
        "type": "object",
        "required": ["criterion_id", "passed", "score", "severity", "message", "evidence"],
        "properties": {
          "criterion_id": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "tier": {"type": ["string", "null"]},
          "weight": {"type": ["integer", "null"]},
          "passed": {"type": "boolean"},
          "score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "severity": {"type": "string", "enum": ["info", "warn", "fail", "critical"]},
          "message": {"type": "string"},
          "evidence": {"type": "object"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Run metadata: store info, modes used, rubric provenance, ground-truth info. Shape varies by subcommand."
    }
  }
}
